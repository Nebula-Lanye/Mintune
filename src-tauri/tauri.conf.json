{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Mintune",
  "version": "0.4.805",
  "identifier": "com.mintune.music",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:8081",
    "beforeDevCommand": "pnpm dev:metro"
  },
  "app": {
    "windows": [
      {
        "title": "Mintune 薄荷音乐",
        "width": 1280,
        "height": 820,
        "minWidth": 720,
        "minHeight": 520,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "deb"],
    "shortDescription": "本地优先的音乐播放器",
    "longDescription": "Mintune 薄荷音乐是一款本地优先的音乐播放器。",
    "category": "Music",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
